        <div class="alert alert-info">
            📎 Para solicitar outros documentos ou materiais, entre em <a href="/contato" style="font-weight:700;color:var(--verde-escuro);text-decoration:underline;">contato com o grupo</a>.
        </div>

    </div>
</div>

<%- include('partials/footer.ejs') %>

<style>
.downloads-lista { display: flex; flex-direction: column; gap: 0; }

.download-item {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
}

.download-icone {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, var(--floresta), var(--verde-escuro));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--sh-2);
}

.download-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}
.download-info strong {
    font-size: 15px;
    font-weight: 700;
    color: var(--floresta);
    display: block;
}
.download-info span {
    font-size: 13px;
    color: var(--texto-suave);
    line-height: 1.4;
}
.download-meta {
    font-size: 11px;
    color: var(--terra);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .8px;
}

.download-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    background: var(--verde-escuro);
    color: #fff;
    border-radius: var(--r-md);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s, transform .2s;
    min-height: var(--tap);
    flex-shrink: 0;
}
.download-btn:hover { background: var(--floresta); transform: translateY(-2px); }

@media (max-width: 500px) {
    .download-item { flex-wrap: wrap; }
    .download-btn { width: 100%; justify-content: center; }
}
</style>
