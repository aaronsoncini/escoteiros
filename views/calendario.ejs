<%- include('partials/header.ejs') %>
<%- include('partials/navbar.ejs') %>

<div class="page-wrapper">
    <div class="page-header">
        <h1>Calendário <%= anoAtual %></h1>
        <p class="subtitle">Todos os eventos e atividades do ano</p>
    </div>

    <div class="container">
        <% if (eventos.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon">🗓️</div>
            <p>Nenhum evento no calendário ainda.</p>
        </div>
        <% } else {
            const mesesNomes = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

            // Agrupa eventos por mês
            const porMes = {};
            eventos.forEach(ev => {
                const d = new Date(ev.data + 'T00:00:00');
                const key = d.getMonth();
                if (!porMes[key]) porMes[key] = [];
                porMes[key].push({ ...ev.dataValues, _dia: d.getDate() });
            });
        %>
            <% Object.keys(porMes).sort((a,b)=>a-b).forEach(mesIdx => { %>
            <div class="cal-mes">
                <h3><%= mesesNomes[mesIdx] %></h3>
                <% porMes[mesIdx].forEach(ev => { %>
                <div class="cal-evento">
                    <div class="cal-dia"><%= String(ev._dia).padStart(2,'0') %></div>
                    <div class="cal-info">
                        <div class="cal-titulo"><%= ev.titulo %></div>
                        <% if (ev.local) { %><div class="cal-local">📍 <%= ev.local %></div><% } %>
                        <% if (ev.horario) { %><div class="cal-local">🕐 <%= ev.horario %></div><% } %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% }) %>
        <% } %>

        <div class="alert alert-info" style="margin-top:20px;">
            📋 Para eventos com imagens e mais detalhes, acesse a <a href="/agenda" style="font-weight:700;color:var(--verde-escuro);text-decoration:underline;">Agenda</a>.
        </div>
    </div>
</div>

<%- include('partials/footer.ejs') %>
