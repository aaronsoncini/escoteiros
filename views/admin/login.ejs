<%- include('../partials/header.ejs') %>
<body style="background:var(--creme);display:flex;align-items:center;justify-content:center;min-height:100vh;">
<link rel="stylesheet" href="/style.css">

<div style="width:100%;max-width:400px;padding:24px;">
    <div class="card" style="text-align:center;">
        <div style="margin-bottom:20px;">
            <svg viewBox="0 0 24 24" width="48" height="48" style="color:var(--verde-escuro);">
                <path fill="currentColor" d="M12 2c-1.4 2.4-2 4.5-2 6 0 1.7 1 2.5 2 3 1-.5 2-1.3 2-3 0-1.5-.6-3.6-2-6zm-5 7c-1.2 1-2 2.2-2 3.5 0 1.4 1.1 2.5 2.5 2.5 1.1 0 2-.7 2.3-1.7-1.5-1-2.4-2.4-2.8-4.3zm10 0c-.4 1.9-1.3 3.3-2.8 4.3.3 1 1.2 1.7 2.3 1.7 1.4 0 2.5-1.1 2.5-2.5 0-1.3-.8-2.5-2-3.5zM12 13c-.7 0-1.3.2-1.8.5L9 22h6l-1.2-8.5c-.5-.3-1.1-.5-1.8-.5z"/>
            </svg>
        </div>
        <h2 style="font-family:'Bitter',Georgia,serif;color:var(--floresta);margin-bottom:4px;">Área Restrita</h2>
        <p style="font-size:14px;color:var(--texto-suave);margin-bottom:24px;">71º Grupo Escoteiro Minuano</p>

        <% if (erro) { %>
        <div class="alert alert-erro"><%= erro %></div>
        <% } %>

        <form method="post" action="/admin/login">
            <div class="form-group">
                <div class="form-field">
                    <label for="usuario">Usuário</label>
                    <input type="text" id="usuario" name="usuario" placeholder="Digite seu usuário" required autofocus>
                </div>
                <div class="form-field">
                    <label for="senha">Senha</label>
                    <input type="password" id="senha" name="senha" placeholder="Digite sua senha" required>
                </div>
                <button type="submit" class="btn btn-primary btn-full">Entrar</button>
            </div>
        </form>
        <p style="margin-top:16px;font-size:12px;color:var(--texto-suave);">
            <a href="/" style="color:var(--verde-escuro);">← Voltar ao site</a>
        </p>
    </div>
</div>
</body>
</html>
