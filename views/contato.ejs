<style>
/* ── HERO (reutiliza variáveis do style.css global) ── */
.hero-scout {
    position: relative;
    background: radial-gradient(circle at 20% 20%, rgba(147,192,31,.18), transparent 50%),
                linear-gradient(135deg, var(--floresta) 0%, var(--floresta-dark) 60%, var(--verde-escuro) 100%);
    color: #fff;
    padding: 64px var(--pad-x) 90px;
    overflow: hidden;
}
.topo-bg { position:absolute; inset:0; width:100%; height:100%; z-index:0; pointer-events:none; }
.deco-bussola { display:none; position:absolute; top:50%; right:6%; width:240px; height:240px; transform:translateY(-55%); opacity:.6; z-index:1; pointer-events:none; animation: girarBussola 80s linear infinite; }
@keyframes girarBussola { from{transform:translateY(-55%) rotate(0)} to{transform:translateY(-55%) rotate(360deg)} }
.hero-conteudo { position:relative; z-index:3; max-width:1200px; margin:0 auto; width:100%; }
.eyebrow { display:inline-flex; align-items:center; gap:8px; padding:8px 16px; background:rgba(255,255,255,.13); border:1px solid rgba(255,255,255,.28); border-radius:var(--r-pill); font-size:.78rem; font-weight:600; text-transform:uppercase; letter-spacing:1.2px; color:#fff; margin-bottom:22px; }
.hero-scout h1 { font-size:clamp(1.9rem,6.2vw,3.6rem); font-weight:900; line-height:1.1; margin-bottom:18px; color:#fff; }
.hero-scout .destaque { color:var(--verde-claro); }
.hero-scout .quebra { display:block; }
.hero-scout .hero-conteudo > p { font-size:clamp(.98rem,2.5vw,1.1rem); color:rgba(255,255,255,.88); max-width:560px; margin-bottom:26px; line-height:1.55; }
.hero-stats { display:flex; flex-wrap:wrap; gap:14px; background:rgba(10,38,20,.55); border:1px solid rgba(255,255,255,.22); border-radius:var(--r-lg); padding:18px 20px; width:fit-content; }
.stat { display:flex; flex-direction:column; gap:3px; }
.stat strong { font-size:.95rem; font-weight:600; color:#fff; }
.stat span { font-size:.8rem; color:rgba(255,255,255,.7); }
.stat-divider { width:1px; background:rgba(255,255,255,.22); align-self:stretch; }
.hero-mountains { position:absolute; bottom:-1px; left:0; width:100%; height:60px; z-index:1; pointer-events:none; }

/* ── BADGES ── */
.badges-rapidos { display:grid; grid-template-columns:1fr; gap:14px; max-width:1200px; margin:30px auto 0; padding:0 var(--pad-x); }
.badge-info { background:var(--branco); border-radius:var(--r-lg); padding:22px; box-shadow:var(--sh-2); border-top:3px solid var(--verde-claro); transition:transform .3s var(--ease-out), box-shadow .3s; }
.badge-info:hover { transform:translateY(-4px); box-shadow:var(--sh-4); }
.badge-info:nth-child(2) { border-top-color:var(--terra); }
.badge-info:nth-child(3) { border-top-color:var(--ouro); }
.badge-info:nth-child(4) { border-top-color:var(--verde-escuro); }
.badge-icon { width:44px; height:44px; border-radius:var(--r-md); background:linear-gradient(135deg,var(--floresta-dark),var(--verde-escuro)); color:#fff; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
.badge-info:nth-child(2) .badge-icon { background:linear-gradient(135deg,var(--couro),var(--terra)); }
.badge-info:nth-child(3) .badge-icon { background:linear-gradient(135deg,#B57F26,var(--ouro)); }
.badge-info:nth-child(4) .badge-icon { background:linear-gradient(135deg,var(--verde-claro),#6FA014); }
.badge-info h3 { font-size:.78rem; text-transform:uppercase; letter-spacing:1.2px; color:var(--floresta); margin-bottom:6px; font-weight:700; }
.badge-info p, .badge-info a { font-size:.92rem; color:var(--texto-suave); text-decoration:none; line-height:1.5; }
.badge-info a:hover { color:var(--verde-escuro); text-decoration:underline; }

/* ── LAYOUT PRINCIPAL ── */
.contato-principal { display:grid; grid-template-columns:1fr; gap:22px; max-width:1200px; margin:36px auto; padding:0 var(--pad-x); align-items:start; }

/* ── CARD FORMULÁRIO ── */
.cartao-formulario { background:var(--branco); border-radius:var(--r-xl); padding:28px; box-shadow:var(--sh-3); position:relative; overflow:hidden; }
.cartao-formulario::before { content:''; position:absolute; top:0; left:0; right:0; height:5px; background:linear-gradient(90deg,var(--verde-escuro),var(--verde-claro),var(--ouro),var(--terra)); }
.cartao-cabecalho { margin-bottom:22px; }
.cartao-cabecalho h2 { font-size:clamp(1.4rem,4.5vw,1.85rem); color:var(--floresta); margin-bottom:6px; font-weight:700; }
.cartao-cabecalho p { color:var(--texto-suave); font-size:clamp(.88rem,2.5vw,.95rem); }

/* ── GOOGLE FORMS EMBED ── */
.form-embed { position:relative; width:100%; border:1.5px solid #E2DCC9; border-radius:var(--r-md); background:var(--creme); overflow:hidden; }
.form-embed iframe { display:block; width:100%; border:0; background:var(--creme); height:1850px; }
@media (min-width:375px) { .form-embed iframe { height:1740px; } }
@media (min-width:425px) { .form-embed iframe { height:1650px; } }
@media (min-width:560px) { .form-embed iframe { height:1520px; } }
@media (min-width:768px) { .form-embed iframe { height:1420px; } }
@media (min-width:1024px) { .form-embed iframe { height:1340px; } }

.form-fallback { margin-top:16px; font-size:.85rem; color:var(--texto-suave); text-align:center; }
.form-fallback a { color:var(--verde-escuro); font-weight:600; text-decoration:underline; text-underline-offset:3px; }
.form-fallback a:hover { color:var(--floresta); }

/* ── LADO DIREITO ── */
.lado-direito { display:flex; flex-direction:column; gap:18px; }

/* ── MAPA ── */
.cartao-mapa { background:var(--branco); border-radius:var(--r-xl); overflow:hidden; box-shadow:var(--sh-2); }
.mapa-iframe { width:100%; height:clamp(220px,40vw,300px); background:var(--cinza-medio); }
.mapa-iframe iframe { display:block; width:100%; height:100%; border:0; }
.mapa-info { display:flex; align-items:flex-start; gap:14px; padding:18px 20px; }
.pin-circle { flex:0 0 44px; width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,var(--ouro),#B57F26); color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:var(--sh-2); }
.mapa-info strong { display:block; font-size:.95rem; color:var(--floresta); margin-bottom:4px; font-weight:600; }
.mapa-info span { font-size:.83rem; color:var(--texto-suave); line-height:1.5; }
