<%- include('partials/header.ejs') %>
<%- include('partials/navbar.ejs') %>

<div class="page-wrapper">
    <div class="page-header">
        <h1>Agenda</h1>
        <p class="subtitle">Próximas atividades e eventos do Grupo Minuano</p>
    </div>

    <div class="container">
        <% if (eventos.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon">📅</div>
            <p>Nenhum evento agendado no momento. Volte em breve!</p>
        </div>
        <% } else { %>
            <% eventos.forEach(evento => {
                const dataEvento = new Date(evento.data + 'T00:00:00');
                const dia = String(dataEvento.getDate()).padStart(2, '0');
                const meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
                const mes = meses[dataEvento.getMonth()];
            %>
            <div class="evento-card">
                <div class="data-box">
                    <div class="dia"><%= dia %></div>
                    <div class="mes"><%= mes %></div>
                </div>
                <div class="info">
                    <h3><%= evento.titulo %></h3>
                    <% if (evento.horario) { %><p class="horario">🕐 <%= evento.horario %></p><% } %>
                    <% if (evento.local) { %><p class="local">📍 <%= evento.local %></p><% } %>
                    <% if (evento.descricao) { %><p class="desc"><%= evento.descricao %></p><% } %>
                </div>
                <% if (evento.imagem) { %>
                <img src="/imgs/eventos/<%= evento.imagem %>" alt="<%= evento.titulo %>">
                <% } %>
            </div>
            <% }) %>
        <% } %>

        <div class="alert alert-info" style="margin-top:30px;">
            📌 Atividades aos sábados das 14h às 18h na Av. Waldemar Tietz, 1154 — Zona Leste, São Paulo.
            Consulte também o <a href="/calendario" style="font-weight:700;color:var(--verde-escuro);text-decoration:underline;">Calendário Anual</a>.
        </div>
    </div>
</div>

<%- include('partials/footer.ejs') %>
